# RouteRight environment variables - copy to .env and fill in your values

# AWS Bedrock Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key       # Or use AWS CLI profiles / IAM roles
# AWS_SECRET_ACCESS_KEY=your-secret

# Model IDs (Amazon Bedrock model identifiers)
ROUTERIGHT_FRONTIER_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0
ROUTERIGHT_SMALL_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0

# Decider 2B Configuration
ROUTERIGHT_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21
ROUTERIGHT_DECIDER_DEVICE=cpu
# ROUTERIGHT_DECIDER_URL=http://127.0.0.1:8000  # If using server mode instead of local

# Router Configuration
ROUTERIGHT_CONFIDENCE_THRESHOLD=0.7
ROUTERIGHT_MAX_TOKENS=1024

# Mock Mode (set to "true" for testing without AWS costs)
ROUTERIGHT_MOCK_MODE=false

# Server
ROUTERIGHT_HOST=0.0.0.0
ROUTERIGHT_PORT=8080
