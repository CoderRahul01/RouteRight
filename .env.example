# RouteRight environment configuration
# Copy to .env and adjust as needed

# AWS Bedrock Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# Model Identifiers
ROUTERIGHT_FRONTIER_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0
ROUTERIGHT_SMALL_MODEL=amazon.nova-micro-v1:0

# Strands Decider 2B Settings
ROUTERIGHT_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21
ROUTERIGHT_DECIDER_DEVICE=cpu
ROUTERIGHT_DECIDER_URL=http://127.0.0.1:8001

# Policy & Threshold
ROUTERIGHT_CONFIDENCE_THRESHOLD=0.70
ROUTERIGHT_MAX_TOKENS=1024
ROUTERIGHT_DAILY_USD_CAP=5.00

# Server Bindings (default 127.0.0.1 for local security)
ROUTERIGHT_HOST=127.0.0.1
ROUTERIGHT_PORT=8000

# Mock Mode (set true ONLY for unit tests or offline synthetic simulation)
ROUTERIGHT_MOCK_MODE=false
